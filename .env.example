# =============================================================================
# Variables de entorno del frontend de CompensaTuViaje
# =============================================================================
#
# Copia este archivo a .env:
#
#     cp .env.example .env
#
# Todas las variables de Vite empiezan con VITE_ y quedan visibles en el
# navegador: NUNCA pongas aquí una clave secreta. Lo secreto va en el backend.
# =============================================================================

# API del backend. Debe apuntar al puerto donde corre (3002 en local).
# Sin esto, el código usa http://localhost:3001/api y no encuentra el backend.
VITE_API_URL=http://localhost:3002/api
VITE_APP_API_URL=http://localhost:3002/api

# Supabase: inicio de sesión de personas (B2C) con Google.
# Son claves públicas por diseño (la "anon key"). Sin esto, el login B2C no
# funciona; empresas y partners sí. Pide las del proyecto de desarrollo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Blockchain: red de los certificados NFT.
# polygon = Polygon mainnet (producción) | localhost = Hardhat local (31337)
VITE_BLOCKCHAIN_NETWORK=localhost
VITE_CONTRACT_ADDRESS_LOCAL=
VITE_CONTRACT_ADDRESS_POLYGON=
