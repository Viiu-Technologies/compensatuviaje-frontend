# Equivalente a vercel.json para servir el frontend desde la VPS.
#
# La imagen oficial de nginx pasa este archivo por envsubst al arrancar y solo
# reemplaza variables de entorno definidas, así que $uri y compañía quedan intactas.
#   BACKEND_UPSTREAM  backend por la red interna del proyecto, ej. http://backend:3000
#   NGINX_RESOLVER    DNS interno de Docker (127.0.0.11 por defecto)
#
# Los rewrites hacia el backend van por la red interna y NO por
# https://api.compensatuviaje.com: si pasaran otra vez por Cloudflare, CF-Connecting-IP
# sería la IP de la VPS y todas las visitas a /blog y /share compartirían el mismo
# contador del rate limit. Por la red interna, nginx reenvía la cabecera original.

# Mismo criterio que los headers X-Robots-Tag de vercel.json. Se calcula sobre la URL
# original ($request_uri), así se aplica también cuando la ruta cae en index.html.
map $request_uri $robots_tag {
    default                                                                                                        "";
    "~^/(admin|partner|b2c|b2b|dashboard|onboarding|company|auth|login|register|forgot-password|verify|impacto|share)" "noindex, nofollow";
    "~^/blog/(confirmar|baja)/"                                                                                    "noindex, nofollow";
}

# Content-Security-Policy en modo Report-Only: el navegador no bloquea nada, solo
# avisa en la consola de lo que bloquearía. Sirve para afinar la lista antes de
# pasarla a Content-Security-Policy. Orígenes, según lo que carga el front:
#   style-src   'unsafe-inline': atributos style de React y los <style> de sonner/framer-motion
#   img-src     https: fotos de proyectos, logos y avatares vienen de varios dominios
#   connect-src API, Supabase (auth por https y realtime por wss)
#   form-action Webpay (el pago es un POST de formulario a Transbank, producción e integración)
# Vacío = no se envía: el HTML que genera el backend (/blog, /blog/:slug,
# /share/profile, /og) no sigue esta política; /blog/confirmar y /blog/baja sí son la SPA.
map $request_uri $csp_report_only {
    default                                         "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.compensatuviaje.com https://ypckedscmjxgmyfewndr.supabase.co wss://ypckedscmjxgmyfewndr.supabase.co; frame-src 'self'; form-action 'self' https://webpay3g.transbank.cl https://webpay3gint.transbank.cl; object-src 'none'; base-uri 'self'; frame-ancestors 'self'";
    "~^/blog(?!/(confirmar|baja)/)(/|$|\?)"         "";
    "~^/share/profile/"                             "";
    "~^/og/"                                        "";
}

# HTML nunca en caché. `location ~ \.html$` ya lo hacía, pero `/` y las páginas
# prerenderizadas (/calculadora, /pagos…) las sirve `location /` directamente desde
# dist/<ruta>/index.html, sin pasar por esa location: salían sin Cache-Control y el
# navegador reutilizaba el HTML viejo durante horas (caché heurística por
# Last-Modified), que apuntaba al bundle anterior. Tras un despliegue la portada
# seguía con el código de antes. Vacío = no se envía (imágenes, texturas, etc.).
map $sent_http_content_type $html_cache_control {
    default        "";
    "~^text/html"  "no-cache, no-store, must-revalidate";
}

# Bots de redes sociales (vistas previas de enlaces). Solo ellos reciben las
# etiquetas del certificado en /verify/:id; las personas siguen en la SPA.
map $http_user_agent $is_social_bot {
    default 0;
    "~*(whatsapp|facebookexternalhit|facebot|linkedinbot|twitterbot|slackbot|telegrambot|discordbot|skypeuripreview|pinterest|applebot|vkshare)" 1;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Con proxy_pass a una variable, el nombre se resuelve en cada petición: nginx
    # arranca aunque el backend todavía no esté arriba.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $backend ${BACKEND_UPSTREAM};

    server_tokens off;
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;
    # Brotli lo agrega Cloudflare hacia el usuario.

    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # CF-Connecting-IP pasa tal cual (nginx reenvía las cabeceras del cliente).

    # --- Rewrites hacia el backend ---
    location = /blog {
        include /etc/nginx/snippets/headers.conf;
        proxy_pass $backend/api/news/page$is_args$args;
    }
    location = /blog/feed.xml {
        include /etc/nginx/snippets/headers.conf;
        proxy_pass $backend/api/news/feed.xml;
    }
    location = /blog/sitemap.xml {
        include /etc/nginx/snippets/headers.conf;
        proxy_pass $backend/api/news/sitemap.xml;
    }
    # Páginas de la SPA (confirmar y dar de baja la suscripción).
    location ^~ /blog/confirmar/ {
        include /etc/nginx/snippets/headers.conf;
        try_files /index.html =404;
    }
    location ^~ /blog/baja/ {
        include /etc/nginx/snippets/headers.conf;
        try_files /index.html =404;
    }
    location ~ ^/blog/([^/]+)$ {
        include /etc/nginx/snippets/headers.conf;
        proxy_pass $backend/api/news/page/$1$is_args$args;
    }
    location ~ ^/share/profile/([^/]+)$ {
        include /etc/nginx/snippets/headers.conf;
        proxy_pass $backend/api/public/share/profile/$1$is_args$args;
    }
    # Imagen para compartir el perfil (CTV-67). Mismo dominio que el enlace y
    # con extensión .jpg para que Cloudflare la guarde en caché; antes venía de
    # api.compensatuviaje.com y WhatsApp a veces no la alcanzaba a traer.
    location ~ ^/og/profile/([^/]+\.jpg)$ {
        include /etc/nginx/snippets/headers.conf;
        proxy_pass $backend/api/public/og/profile/$1$is_args$args;
    }

    # --- Archivos estáticos ---
    location /assets/ {
        include /etc/nginx/snippets/headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ~ \.html$ {
        include /etc/nginx/snippets/headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # /verify/<id>: WhatsApp no ejecuta JavaScript y solo veía las etiquetas
    # genéricas de index.html. A los bots se les responde con las del
    # certificado (backend); a las personas, la SPA de siempre.
    location ~ "^/verify/([0-9a-fA-F-]{36})$" {
        include /etc/nginx/snippets/headers.conf;
        if ($is_social_bot) {
            rewrite "^/verify/([0-9a-fA-F-]{36})$" /__certificate_meta/$1 last;
        }
        try_files $uri /index.html;
    }
    location ~ "^/__certificate_meta/([0-9a-fA-F-]{36})$" {
        internal;
        include /etc/nginx/snippets/headers.conf;
        proxy_pass $backend/api/public/share/certificate/$1;
    }

    # Páginas prerenderizadas (dist/<ruta>/index.html) y, si no, la SPA.
    location / {
        include /etc/nginx/snippets/headers.conf;
        add_header Cache-Control $html_cache_control always;
        try_files $uri $uri/index.html /index.html;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
}
